-  font-weight: 800;
-  font-size: 1.75rem;
-  margin-top: 1.5em;
-  margin-bottom: 0.5em;
-  color: #fff;
-  text-transform: uppercase;
-  letter-spacing: -0.02em;
-  border-bottom: 2px solid #333;
-  padding-bottom: 0.25em;
-}
-
